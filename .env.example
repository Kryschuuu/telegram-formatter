# telegram-formatter — Umgebungsvorlage für lokales Docker-Deployment
# =======================================================================
# Verwendung (einmalig auf dem Server 192.168.0.10):
#   cp .env.example .env
#   $EDITOR .env            # Pflichtwerte eintragen (siehe „PFLICHT" unten)
#   docker compose up --build -d
#
# SICHERHEIT: Die echte .env enthält Geheimnisse und steht in .gitignore —
# sie wird NIE committet. Diese Vorlage enthält ausschließlich Platzhalter
# und gefahrlose Standardwerte (Vertragstest: tests/test_deployment.py).

# --- PFLICHT: geteilter Bot ----------------------------------------------
# Token von @BotFather (ohne Shell-Historie erzeugen, z. B. per Passwort-
# Manager einfügen). HIER NUR ALS PLATZHALTER — echten Wert in .env legen.
TELEGRAM_BOT_TOKEN=ersetze-mich-token-von-botfather

# --- PFLICHT für den Demo-Betrieb: Zielchat pinnen -------------------------
# Numerische ID der öffentlichen Supergroup / des öffentlichen Kanals, in
# den der geteilte Bot sendet (Bot muss Mitglied sein, im Kanal mit Recht
# „Nachrichten senden"). Pinnt /api/send auf GENAU diesen Chat — abweichende
# chat_id-Werte aus Requests werden abgewiesen (kein offener Relay).
TELEGRAM_CHAT_ID=-1001234567890

# --- Offenlegung des Ziel-Kanals (muss zu TELEGRAM_CHAT_ID gehören!) ------
# Standard-Output-Kanal der öffentlichen Demo: t.me/mdtotxt_bot_web
# Die Seite nennt diesen Kanal an sieben Stellen und verlinkt ihn; nur
# https://t.me/<handle>, t.me/<handle> und @<handle> werden akzeptiert.
TELEGRAM_FORMATTER_SHARED_BOT_HANDLE=@mdtotxt_bot
TELEGRAM_FORMATTER_SHARED_CHAT_URL=https://t.me/mdtotxt_bot_web
# Tage bis zur automatischen Löschung im Kanal (Telegram-Einstellung
# „Nachrichten automatisch löschen" — 1 Monat = 30). 0 = keine Aussage.
TELEGRAM_FORMATTER_SHARED_RETENTION_DAYS=30

# --- Geteilter Bot im Browser ----------------------------------------------
# 1 (Standard): Besucher senden ohne eigenes Setup in den gepinnten Chat
#     (mit confirm_public-Bestätigung + engen Limits, siehe unten).
# 0: Shared-Versand nur per API mit Operator-Secret (Browser nutzt BYOB).
TELEGRAM_FORMATTER_SHARED_WEB_SEND=1

# --- OPTIONAL: Operator-Secret für authentifizierte API-Nutzung -----------
# Leer lassen für reinen Demo-Betrieb. Wenn gesetzt, verlangen alle POST-
# Endpunkte den Header X-Auth-Token — AUSSER /api/send bei freigegebenem
# Browser-Versand (der Browser erhält dieses Secret nie!). Erzeugen mit:
#   openssl rand -hex 32
TELEGRAM_FORMATTER_API_TOKEN=

# --- Reverse-Proxy (Docker Compose + Caddy) --------------------------------
# Anzahl vertrauenswürdiger Proxy-Hops für die echte Client-IP. Hinter dem
# mitgelieferten Compose-Stack steht IMMER genau ein Hop (Caddy) — der Wert
# wird dort explizit auf 1 erzwungen; diese Zeile gilt nur für Betrieb OHNE
# Compose (z. B. Render-Blueprint: 1, Direktbetrieb ohne Proxy: 0).
TELEGRAM_FORMATTER_TRUSTED_PROXY_HOPS=1

# --- Limits (Standardwerte, nur bei Bedarf anfassen) -----------------------
# Maximale Textlänge je Konvertierung/Versand (authentifizierte Aufrufe).
TELEGRAM_FORMATTER_MAX_INPUT_CHARS=100000
# Längenkappe für ANONYME Browser-Sendungen (lange Eingaben werden in
# Telegram-Chunks aufgeteilt, Codeblöcke bleiben je Chunk wohlgeformt).
TELEGRAM_FORMATTER_SHARED_WEB_MAX_INPUT_CHARS=64000
# Frequenzlimits pro Minute (pro IP, bzw. TOTAL = instanzweit).
TELEGRAM_FORMATTER_SENDS_PER_MINUTE=6
TELEGRAM_FORMATTER_CONVERTS_PER_MINUTE=60
TELEGRAM_FORMATTER_SHARED_WEB_SENDS_PER_MINUTE=4
TELEGRAM_FORMATTER_SHARED_WEB_SENDS_PER_MINUTE_TOTAL=30

# --- Eigene Bots (BYOB-Web-Sessions, Standard: an) -------------------------
# 0 blendet UI + API-Endpunkte aus (keine fremden Tokens über die Instanz).
TELEGRAM_FORMATTER_BYOB_ENABLED=1
TELEGRAM_FORMATTER_BYOB_SESSIONS_PER_MINUTE=3
TELEGRAM_FORMATTER_BYOB_DISCOVER_PER_MINUTE=3
TELEGRAM_FORMATTER_BYOB_SENDS_PER_MINUTE=6
# Lebensdauer / Leerlauf-Timeout einer Session in Sekunden.
TELEGRAM_FORMATTER_BYOB_TTL_SECONDS=1800
TELEGRAM_FORMATTER_BYOB_IDLE_SECONDS=600
